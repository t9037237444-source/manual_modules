<script type="text/javascript">
// Обновить счётчик
function updateCount() {
  var total = $('.cat-checkbox').length;
  var checked = $('.cat-checkbox:checked').length;
  $('#included-count').text(checked);
}

// Выбрать все
function selectAllCategories() {
  $('.cat-checkbox').prop('checked', true);
  $('.cat-hidden').prop('disabled', true);
  $('.tree-cat-item').css('opacity', '1');
  updateCount();
}

// Снять все
function unselectAllCategories() {
  $('.cat-checkbox').prop('checked', false);
  $('.cat-hidden').prop('disabled', false);
  $('.tree-cat-item').css('opacity', '0.5');
  updateCount();
}

// Обработка чекбоксов
$('.cat-checkbox').on('change', function() {
  var $hidden = $(this).closest('.checkbox').find('.cat-hidden');
  var $item = $(this).closest('.tree-cat-item');
  
  if (this.checked) {
    // Включена — скрыть hidden (не отправлять)
    $hidden.prop('disabled', true);
    $item.css('opacity', '1');
  } else {
    // Выключена — показать hidden (отправить как исключённую)
    $hidden.prop('disabled', false);
    $item.css('opacity', '0.5');
  }
  updateCount();
});

// Инициализация счётчика
$(document).ready(function() {
  updateCount();
});
</script>

